{
  "manifest_version": 3,
  "name": "SOLAT Browser Control",
  "version": "1.0.0",
  "description": "Owner-paired Chrome control for SOLAT with private authentication handoff.",
  "key": "",
  "permissions": ["activeTab", "alarms", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" },
  "action": {
    "default_title": "SOLAT Browser Control",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }]
}
