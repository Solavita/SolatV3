{
  "schema_version": "1.0",
  "name": "SOLAT deterministic conversation and search corpus",
  "cases": [
    { "id": "general_chat_en", "content": "Hi, can you help me plan my study session?", "expect": { "top_intent": "general_chat", "web_search": false, "model_first": true } },
    { "id": "latest_info_en", "content": "Find the latest reliable source about Ada Lovelace.", "expect": { "top_intent": "web_search", "web_search": true, "model_first": true, "requested_source_scopes": [] } },
    { "id": "latest_info_th", "content": "ค้นหาข้อมูลล่าสุดเกี่ยวกับ Ada Lovelace พร้อมแหล่งที่มา", "expect": { "web_search": true, "model_first": true } },
    { "id": "follow_up_context", "content": "find a reliable source about it", "history": [{ "role": "user", "content": "We were discussing Ada Lovelace." }, { "role": "assistant", "content": "Ada Lovelace was a mathematician." }], "expect": { "web_search": true, "prior_turn_count": 2 } },
    { "id": "lowercase_subject_follow_up", "content": "find a source about it", "history": [{ "role": "user", "content": "park dayoung" }, { "role": "assistant", "content": "Which one do you mean?" }], "expect": { "web_search": true, "prior_turn_count": 2, "reference_resolution": "resolved_from_context", "context_entity": "park dayoung", "query_variant": "park dayoung" } },
    { "id": "follow_up_context_th", "content": "หาข้อมูลเกี่ยวกับเขาพร้อมแหล่งที่มา", "history": [{ "role": "user", "content": "We were discussing Ada Lovelace." }, { "role": "assistant", "content": "Ada Lovelace was a mathematician." }], "expect": { "web_search": true, "prior_turn_count": 2, "reference_resolution": "resolved_from_context", "context_entity": "Ada Lovelace" } },
    { "id": "follow_up_context_video", "content": "find a YouTube source about it", "history": [{ "role": "user", "content": "We were discussing Ada Lovelace." }, { "role": "assistant", "content": "Ada Lovelace was a mathematician." }], "expect": { "web_search": true, "prior_turn_count": 2, "reference_resolution": "resolved_from_context", "context_entity": "Ada Lovelace", "source_scope": "video" } },
    { "id": "ordinal_follow_up_context", "content": "Find the first one on Pinterest", "history": [{ "role": "user", "content": "Compare Park-Dayoung and Han Nari" }, { "role": "assistant", "content": "I can compare those two names if you want." }], "expect": { "web_search": true, "prior_turn_count": 2, "reference_resolution": "resolved_ordinal_context", "context_entity": "Park-Dayoung", "reference_ordinal": 0, "query_variant": "Park-Dayoung", "source_scope": "social" } },
    { "id": "thai_ordinal_follow_up_context", "content": "\u0e04\u0e49\u0e19\u0e2b\u0e32\u0e04\u0e19\u0e41\u0e23\u0e01\u0e43\u0e19 Pinterest", "history": [{ "role": "user", "content": "Compare Park-Dayoung and Han Nari" }, { "role": "assistant", "content": "I can compare those two names if you want." }], "expect": { "web_search": true, "prior_turn_count": 2, "reference_resolution": "resolved_ordinal_context", "context_entity": "Park-Dayoung", "reference_ordinal": 0, "query_variant": "Park-Dayoung", "source_scope": "social" } },
    { "id": "hyphenated_name", "content": "Park-Dayoung", "expect": { "likely_ambiguous": true, "query_variants": ["Park-Dayoung", "Park Dayoung"], "model_first": true } },
    { "id": "comparison_candidates", "content": "compare Park-Dayoung and Han Nari", "expect": { "comparison": true, "entity_count": 2, "web_search": true, "model_first": true, "source_scope_priority": ["encyclopedic", "auto"] } },
    { "id": "hyphenated_comparison_variants", "content": "compare Park-Dayoung and Han Nari", "expect": { "comparison": true, "entity_count": 2, "query_variants": ["compare Park-Dayoung and Han Nari", "Park-Dayoung", "Park Dayoung", "Han Nari", "compare Park Dayoung and Han Nari"] } },
    { "id": "encyclopedic_scope", "content": "Search Wikipedia for Ada Lovelace", "expect": { "web_search": true, "source_scope": "encyclopedic", "requested_source_scopes": ["encyclopedic"] } },
    { "id": "social_scope", "content": "Search Park Dayoung on TikTok and Pinterest", "expect": { "web_search": true, "source_scope": "social", "requested_source_scopes": ["social"], "source_scope_priority": ["social", "auto"] } },
    { "id": "video_scope", "content": "Find a YouTube video about Ada Lovelace", "expect": { "web_search": true, "source_scope": "video", "requested_source_scopes": ["video"] } },
    { "id": "ai_summary_scope", "content": "Search Gemini AI Overview for Ada Lovelace", "expect": { "web_search": true, "source_scope": "ai_summary", "requested_source_scopes": ["ai_summary"] } },
