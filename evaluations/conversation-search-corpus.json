    { "id": "thai_multi_scope_request", "content": "\u0e04\u0e49\u0e19\u0e2b\u0e32 Park Dayoung \u0e43\u0e19\u0e15\u0e34\u0e4a\u0e01\u0e15\u0e47\u0e2d\u0e01 \u0e41\u0e25\u0e30\u0e22\u0e39\u0e17\u0e39\u0e1a", "expect": { "web_search": true, "source_scopes": ["social", "video", "auto"], "requested_source_scopes": ["social", "video"] } },
    { "id": "thai_manhwa_context", "content": "compare Park Dayoung and Han Nari", "history": [{ "role": "user", "content": "\u0e17\u0e31\u0e49\u0e07\u0e2a\u0e2d\u0e07\u0e40\u0e1b\u0e47\u0e19\u0e15\u0e31\u0e27\u0e25\u0e30\u0e04\u0e23\u0e21\u0e31\u0e07\u0e2e\u0e27\u0e32" }], "expect": { "web_search": true, "comparison": true, "context_qualifier": "manhwa character" } },
    { "id": "manhwa_context_scope_candidate", "content": "compare Park Dayoung and Han Nari", "history": [{ "role": "user", "content": "These are manhwa characters." }], "expect": { "web_search": true, "comparison": true, "source_scopes": ["social", "encyclopedic", "auto"], "source_scope_priority": ["social", "encyclopedic", "auto"] } },
    { "id": "hyphenated_manhwa_comparison_variants", "content": "compare Park-Dayoung and Han Nari", "history": [{ "role": "user", "content": "These are manhwa characters." }], "expect": { "comparison": true, "query_variants": ["compare Park-Dayoung and Han Nari", "Park-Dayoung", "Park Dayoung", "Han Nari", "Park-Dayoung manhwa character", "Park Dayoung manhwa character", "Han Nari manhwa character", "compare Park Dayoung and Han Nari"] } },
    { "id": "empty_evidence", "content": "Find a source for a fictional unknown topic", "simulated_search": { "status": "empty", "sources": [] }, "expect": { "truthful_search_status": "empty" } },
    { "id": "degraded_evidence", "content": "Find a source for an unavailable topic", "simulated_search": { "status": "degraded", "sources": [{ "url": "https://en.wikipedia.org/wiki/Ada_Lovelace", "title": "Ada Lovelace" }] }, "expect": { "truthful_search_status": "degraded", "citation_count": 1 } },
    { "id": "citation_disclosure", "content": "Find a cited answer", "simulated_search": { "status": "ready", "sources": [{ "url": "https://en.wikipedia.org/wiki/Ada_Lovelace", "title": "Ada Lovelace" }, { "url": "https://asurascans.com/unsafe", "title": "Unsafe" }] }, "expect": { "truthful_search_status": "ready", "citation_count": 1 } },
    { "id": "live_semantic_parity", "content": "Compare a live SOLAT answer with ChatGPT", "expect": { "manual_review_required": true } }
  ]
}
