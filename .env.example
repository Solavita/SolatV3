# Copy this file to .env for local development. Never commit real keys.
# Primary model architecture. Flash owns normal chat, Agent execution and tool
# loops. Plus is used only for bounded complex reasoning/planning or recovery.
# One Alibaba Model Studio key can serve text and vision; a dedicated vision
# key below overrides it when stricter credential separation is desired.
SOLAT_QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
SOLAT_QWEN_API_KEY=
SOLAT_QWEN_FLASH_MODEL=qwen3.7-flash
SOLAT_QWEN_PLUS_MODEL=qwen3.7-plus
SOLAT_QWEN_FLASH_TIMEOUT_MS=45000
SOLAT_QWEN_PLUS_TIMEOUT_MS=90000
SOLAT_MODEL_MODE=auto

# Optional Alibaba Qwen3-VL-Flash GUI-grounding API. UIA remains first;
# screenshots are sent only when semantic accessibility state is insufficient.
# Set a separate key here only when you do not want vision to inherit the
# main-process SOLAT_QWEN_API_KEY. Keep either key separate from any browser or
# renderer code. Set
# SOLAT_VISION_ENABLED=true only after the QwenCloud free-quota/API-key setup
# has been verified in the QwenCloud console.
SOLAT_VISION_ENABLED=false
SOLAT_VISION_MODEL_PROVIDER=qwencloud_vision
SOLAT_VISION_MODEL_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
SOLAT_VISION_MODEL_API_KEY=
SOLAT_VISION_MODEL_NAME=qwen3-vl-flash
SOLAT_VISION_MODEL_TIMEOUT_MS=60000

# Optional V1 voice core. The API key stays in the Electron main process and is
# never exposed to the renderer. Text chat remains available when these values
# are absent. Choose a Cartesia voice id from your own Cartesia account.
SOLAT_VOICE_ENABLED=true
SOLAT_VOICE_PROVIDER=cartesia
SOLAT_CARTESIA_API_KEY=
SOLAT_CARTESIA_VOICE_ID=
SOLAT_VOICE_STT_MODEL=ink-2
SOLAT_VOICE_TTS_MODEL=sonic-latest
SOLAT_VOICE_LANGUAGE=auto
SOLAT_VOICE_TIMEOUT_MS=30000
SOLAT_VOICE_TURN_END_TIMEOUT_MS=1200
SOLAT_VOICE_TTS_SAMPLE_RATE=44100

# Optional web-search tool. The default uses the no-key DuckDuckGo adapter and
# filters every result to SOLAT's approved source allowlist before model use.
# Supported providers: disabled, wikipedia, searxng, brave, ddg.
SOLAT_SEARCH_PROVIDER=ddg
SOLAT_SEARCH_BASE_URL=
SOLAT_SEARCH_API_KEY=
SOLAT_SEARCH_TIMEOUT_MS=8000
SOLAT_SEARCH_RESULT_LIMIT=5
SOLAT_SEARCH_WIKIPEDIA_FALLBACK=true

# Optional connection to the SOLAT backend business/commerce API. Keep the
# token and user id local; desktop exposes only owner-scoped tools and keeps
# confirmation gates for every persistent or external side effect.
# SOLAT_BACKEND_BASE_URL=http://127.0.0.1:8000
# SOLAT_BACKEND_USER_ID=00000000-0000-0000-0000-000000000000
# SOLAT_BACKEND_TOKEN=
# SOLAT_BACKEND_TIMEOUT_MS=12000
SOLAT_SEARCH_ENGINES=

# Qwen Code / Alibaba Model Studio Token Plan. Keep the real token local.
BAILIAN_TOKEN_PLAN_API_KEY=
