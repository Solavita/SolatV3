# Copy this file to .env for local development. Never commit real keys.
SOLAT_MODEL_PROVIDER=deepseek_api
SOLAT_MODEL_BASE_URL=https://api.deepseek.com
SOLAT_MODEL_API_KEY=
SOLAT_MODEL_NAME=deepseek-v4-flash
# Set to enabled only when the user explicitly wants slower, reasoning-heavy replies.
SOLAT_MODEL_THINKING=disabled
SOLAT_MODEL_TIMEOUT_MS=45000

# Optional web-search tool. The default uses the no-key DuckDuckGo adapter and
# filters every result to SOLAT's approved source allowlist before model use.
# Supported providers: disabled, wikipedia, searxng, brave, ddg.
SOLAT_SEARCH_PROVIDER=ddg
SOLAT_SEARCH_BASE_URL=
SOLAT_SEARCH_API_KEY=
SOLAT_SEARCH_TIMEOUT_MS=8000
SOLAT_SEARCH_RESULT_LIMIT=5
SOLAT_SEARCH_WIKIPEDIA_FALLBACK=true
SOLAT_SEARCH_ENGINES=
